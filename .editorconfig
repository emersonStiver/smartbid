# Editor settings for everything outside frontend/ (frontend/ has its own .editorconfig).
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Spring Initializr generates Java and pom.xml with tabs
[*.{java,xml}]
indent_style = tab
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{cmd,bat,ps1}]
end_of_line = crlf
